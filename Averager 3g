desc:Create RMS Average With Time Control (smartin)
//tags: average rms smooth
//author: smartin
//modified: 2024-03-23
/*

Use this if you need a smoothed audio signal for lower reactance in downstream controls.

This is intended to be a side-chain driver, not a listening effect.

3g: add optional output as sine wave

*/

slider10:source=0<0,1,1{0+1,2+3}>source channels
slider11:window_size_ms=10<1,50,1>window (ms)
slider30:source_out=0<0,1,1{disable,ENABLE}>enable source out
slider40:sine_out=0<0,1,1{disable,ENABLE}>enable sine out
slider41:sine_frequency=18000<100,24000:log>sine frequency
slider60:gain_db=0<-60,12,1>universal gain (dB)

in_pin:source input
in_pin:source input
in_pin:source input
in_pin:source input
out_pin:fx output
out_pin:fx output
out_pin:fx output
out_pin:fx output

@init
buffer_size = srate * 2 * window_size_ms / 1000;
freembuf(buffer_size); // twice the allowed window size
write_ptr = 0;
window_sample_count = srate * window_size_ms / 1000;
gain_out = 10^(gain_db/20);
pi = 2*atan(10^9);

@slider
window_sample_count = srate * window_size_ms / 1000;
gain_out = 10^(gain_db/20);
gain_db == -60 ? gain_out = 0;
sine_periods = window_size_ms / 1000 * sine_frequency;
samples_per_period = window_sample_count / sine_periods;
k = 2 * pi / samples_per_period;

// sine_periods = window_size_ms / 1000 * sine_frequency;
// samples_per_period = window_sample_count / (window_size_ms / 1000 * sine_frequency);
// k = (window_size_ms * 2 * pi) / (window_sample_count * 1000 * sine_frequency);

@block

@sample
source ? (
  in0 = spl2;
  in1 = spl3;
  ) : (
  in0 = spl0;
  in1 = spl1;
  );

// fill the buffer
(write_ptr * 2)[0] = sqr(in0) / window_sample_count;
(write_ptr * 2)[1] = sqr(in1) / window_sample_count;

i = window_sample_count - 1;
lsum = 0;
rsum = 0;

// average over the buffer
while(
  read_ptr = write_ptr - i;
  read_ptr >= 0 ? (
    // use (read_ptr * 2)[0,1]
    lsum += (read_ptr * 2)[0];
    rsum += (read_ptr * 2)[1];
    ) : (
    // read_ptr is negative
    // use (buffer_size + 2*read_ptr)[0,1]
    lsum += (buffer_size + read_ptr * 2)[0];
    rsum += (buffer_size + read_ptr * 2)[1];
    );
  i -= 1;
  i >= 0;
);
lspl = sqrt(lsum);
rspl = sqrt(rsum);

sine_out == 1 ? (
  lsin = lspl * sin(k * write_ptr);
  rsin = rspl * sin(k * write_ptr);
) : (
  lsin = 0;
  rsin = 0;
)
;

write_ptr += 1;
write_ptr >= window_sample_count ? write_ptr = 0;

spl0 = source_out * lspl * gain_out;
spl1 = source_out * rspl * gain_out;

spl2 = sine_out * gain_out * lsin;
spl3 = sine_out * gain_out * rsin;


