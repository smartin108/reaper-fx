desc:Create RMS Average With Time Control (smartin)
//tags: average rms smooth
//author: smartin
//modified: 2024-03-23
/*

Use this if you need a smoothed audio signal for lower reactance in downstream controls.

This is intended to be a side-chain driver, not a listening effect.

3g: add optional output as sine wave

*/

slider10:source=0<0,1,1{0+1,2+3}>source channels
slider11:window_ms=10<1,50,1>window (ms)
slider30:source_out=0<0,1,1{disable,ENABLE}>enable source out
slider40:sine_out=0<0,1,1{disable,ENABLE}>enable sine out
slider41:sinef=18000<100,24000:log>sine frequency
slider60:gain_db=0<-60,12,1>universal gain (dB)

in_pin:source input
in_pin:source input
in_pin:source input
in_pin:source input
out_pin:fx output
out_pin:fx output
out_pin:fx output
out_pin:fx output

@init
buf_size = srate * 2 * 50 / 1000;
freembuf(buf_size); // twice the allowed window size
mem_ptr = 0;
//enable = 0;
window_spl = srate * window_ms / 1000;
gain_out = 10^(gain_db/20);
universal_counter = 0;
k = 2 * pi / srate;

@slider
window_spl = srate * window_ms / 1000;
gain_out = 10^(gain_db/20);
gain_db = -60 ? gain_out = 0;
 
@block

@sample
source ? (
  in0 = spl2;
  in1 = spl3;
  ) : (
  in0 = spl0;
  in1 = spl1;
  );

(mem_ptr * 2)[0] = sqr(in0) / window_spl;
(mem_ptr * 2)[1] = sqr(in1) / window_spl;
(mem_ptr >= window_spl) ? enable = 1;      // enable is latched for the session

i = window_spl - 1;
lsum = 0;
rsum = 0;
while(
  mem_off = mem_ptr - i;
  mem_off >= 0 ? (
    // use (mem_off * 2)[0,1]
    lsum += (mem_off * 2)[0];
    rsum += (mem_off * 2)[1];
    ) : (
    // mem_off is negative
    // use (buf_size + 2*mem_off)[0,1]
    lsum += (buf_size + mem_off * 2)[0];
    rsum += (buf_size + mem_off * 2)[1];
    );
  i -= 1;
  i >= 0;
);
lspl = sqrt(lsum);
rspl = sqrt(rsum);

sine_out = 1 ? (
  lsin = lspl * gain_out * sin(k * sinef * universal_counter);
  rsin = rspl * gain_out * sin(k * sinef * universal_counter);
) : (
  lsin = 0;
  rsin = 0;
)
;

mem_ptr += 1;
mem_ptr >= window_spl ? mem_ptr = 0;

source_out = 1 ? (
  spl0 = lspl * gain_out;
  spl1 = rspl * gain_out;
);
sine_out = 1 ? (
  spl2 = spl0 * lsin;
  spl3 = spl1 * rsin;
);
universal_counter += 1;
